{% extends "admin.html.twig" %}

{% block adminContent %}
    <div class="d-flex">
        <div>
            <h1>{{ 'admin.modules.title'|trans }}</h1>
            <p>{{ 'admin.modules.subtitle'|trans }}</p>
        </div>
    </div>
        
    <table class="table table-hover border">
        <thead>
            <tr class="table-primary">
                <th>{{ 'label.module'|trans }}</th>
                <th>{{ 'label.author'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for module in modules %}
                <tr>
                    <td>
                        <h5>
                            <i class="fa fa-{{ module.iconName }} me-1"></i>
                            {{ module.displayName }}
                        </h5>
                        <p class="m-0">{{ module.description }}</p>
                    </td>
                    <td>
                        {% if module.website and module.author %}
                            <a href="{{ module.website }}" target="_blank" noreferer>
                                {{ module.author }}
                            </a>
                        {% else %}
                            {{ module.author|default('-') }}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
