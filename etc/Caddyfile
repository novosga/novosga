{
	auto_https off
	skip_install_trust

	log {
		level {$CADDY_GLOBAL_LOG_LEVEL:INFO}
		output {$CADDY_GLOBAL_LOG_OUTPUT:stderr}
	}

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

http://:8080 {
	log {
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	encode zstd br gzip
	root {$SERVER_ROOT:public/}

	mercure {
		publisher_jwt {env.MERCURE_PUBLISHER_JWT_KEY}
		anonymous
		cors_origins *
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server {
		resolve_root_symlink false
	}
}

